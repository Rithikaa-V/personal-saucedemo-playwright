{
  "name": "playwright-sdet-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI/API test framework (POM, fixtures, data-driven, SQL checks, sharded CI, Docker)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "merge-reports": "playwright merge-reports --reporter html ./all-blob-reports",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm tests"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
